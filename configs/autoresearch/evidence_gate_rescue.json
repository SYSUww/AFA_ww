{
  "version": "autoresearch_v1",
  "strategy_id": "evidence_gate_rescue",
  "proxy_objective_version": "proxy_v1",
  "domains": {
    "__all__": {
      "retrieval": {
        "top_k": 8,
        "max_hits_for_prompt": 8,
        "ensure_per_doc": true,
        "expand_neighbors": true,
        "include_doc_id_hint": true
      },
      "answering": {
        "prompt_template_id": "evidence_strict",
        "max_hits": 8,
        "extra_context": "请先核对 evidence gate 给出的证据覆盖情况。若证据不足，只能标记为证据不足，不要用常识或题目措辞补全缺失证据。"
      },
      "evidence_gate": {
        "enabled": true,
        "max_rescue_rounds": 2,
        "rescue_top_k": 12,
        "per_doc_quota": 2,
        "min_hit_chars": 24,
        "max_hits_after_rescue": 12,
        "use_llm_coverage_check": false,
        "final_consistency_retry": true
      }
    },
    "financial_reports": {
      "retrieval": {
        "unit_type_boosts": {
          "metric_row": 2.0,
          "paragraph": 1.0
        }
      }
    },
    "financial_contracts": {
      "retrieval": {
        "top_k": 8,
        "max_hits_for_prompt": 8,
        "unit_type_boosts": {
          "element_block": 2.0,
          "paragraph": 1.1
        }
      }
    },
    "insurance": {
      "retrieval": {
        "top_k": 6,
        "max_hits_for_prompt": 6,
        "unit_type_boosts": {
          "formula_block": 2.0,
          "clause_block": 1.3
        }
      }
    },
    "regulatory": {
      "retrieval": {
        "top_k": 8,
        "max_hits_for_prompt": 8
      }
    },
    "research": {
      "retrieval": {
        "top_k": 8,
        "max_hits_for_prompt": 8,
        "unit_type_boosts": {
          "conclusion_block": 1.8,
          "paragraph": 1.0
        }
      }
    }
  }
}
